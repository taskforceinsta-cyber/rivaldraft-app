DATABASE_URL="file:./dev.db"

# Generate your own with: openssl rand -base64 32
AUTH_SECRET="replace-me"

# Required in production on hosts other than Vercel (Railway, Render, etc.)
# so Auth.js trusts the incoming request host.
AUTH_TRUST_HOST="true"

# Gates GET /api/seed -- a one-time-use seeding endpoint for hosts without
# shell access (e.g. Render's Free tier). Generate your own with:
# openssl rand -hex 16
SEED_SECRET="replace-me"
